# Copy to .env.local and fill in only what you need. Every feature below is optional:
# with an empty file the app runs as a planner with a local database.
# Restart `npm run dev` (or redeploy) after changing these.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Postgres connection string. Leave empty locally to use a file database in .pglite/.
# Required on Vercel (add Neon from the Vercel Marketplace; it sets this for you).
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. Optional on Vercel (detected automatically); set it for custom domains.
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Optional: Google sign-in (both values)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional: email reminders (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Without a verified domain, Resend only delivers from onboarding@resend.dev to your own address.
EMAIL_FROM=Weekly Planner <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Optional: Sunday planning calls
#
# Demo mode (no phone, no Twilio, no Vapi): set VOICE_PROVIDER=simulated and ANTHROPIC_API_KEY.
# Real calls: set ANTHROPIC_API_KEY, all VAPI_* and all TWILIO_* values.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

VOICE_PROVIDER=
VAPI_API_KEY=
# Id of a Twilio/Vonage/Telnyx number imported into Vapi (free Vapi numbers can't call out).
VAPI_PHONE_NUMBER_ID=
# Any long random string; the app sends it with each call and checks it on every webhook.
VAPI_WEBHOOK_SECRET=
# Live-call model; must be one Vapi accepts for provider "anthropic".
VOICE_MODEL=claude-sonnet-5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

CALL_MONTHLY_CAP=6
CALL_ALLOWED_COUNTRY_CODES=+1,+44,+370

# ---------------------------------------------------------------------------
# Scheduler (needed for email reminders and scheduled calls)
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=
